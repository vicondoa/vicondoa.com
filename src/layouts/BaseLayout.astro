---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE } from '../site.config';
import '../styles/global.css';

interface ArticleMetadata {
  publishedAt: Date;
  topics: string[];
  updatedAt?: Date;
}

interface Props {
  article?: ArticleMetadata;
  canonical?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  title: string;
}

const {
  article,
  canonical,
  description = SITE.description,
  image = SITE.socialImage,
  noindex = false,
  title,
} = Astro.props;

const pageTitle =
  title === SITE.title
    ? `${SITE.title} | ${SITE.tagline}`
    : `${title} | ${SITE.title}`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE.url);
const imageUrl = new URL(image, SITE.url);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    description: SITE.description,
    url: SITE.url,
    author: {
      '@type': 'Person',
      name: SITE.author,
      sameAs: [SITE.githubUrl],
      url: SITE.url,
    },
  },
  ...(article
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'BlogPosting',
          headline: title,
          description,
          datePublished: article.publishedAt.toISOString(),
          dateModified: (
            article.updatedAt ?? article.publishedAt
          ).toISOString(),
          image: imageUrl.href,
          keywords: article.topics,
          mainEntityOfPage: canonicalUrl.href,
          author: {
            '@type': 'Person',
            name: SITE.author,
            sameAs: [SITE.githubUrl],
            url: SITE.url,
          },
        },
      ]
    : []),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta
      name="theme-color"
      content="#f7f5f0"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#090b10"
      media="(prefers-color-scheme: dark)"
    />

    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE.title} RSS`}
      href="/rss.xml"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <title>{pageTitle}</title>

    <script is:inline>
      (() => {
        const storageKey = 'vicondoa-theme';
        let savedTheme = null;

        try {
          savedTheme = window.localStorage.getItem(storageKey);
        } catch (error) {
          console.warn('Theme preference could not be read.', error);
        }

        const theme =
          savedTheme === 'dark' || savedTheme === 'light'
            ? savedTheme
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';

        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
      })();
    </script>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-frame">
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
