---
import BlogIndexPage from '../../components/BlogIndexPage.astro';
import { getPageCount, getPostsPage, getPublishedPosts } from '../../lib/blog';

const posts = await getPublishedPosts();
const totalPages = getPageCount(posts.length);
const pagePosts = getPostsPage(posts, 1);
---

<BlogIndexPage currentPage={1} posts={pagePosts} totalPages={totalPages} />
