---
import type { BlogPost } from '../lib/blog';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';
import MatrixBackdrop from './MatrixBackdrop.astro';
import Pagination from './Pagination.astro';
import PostCard from './PostCard.astro';

interface Props {
  basePath: string;
  currentPage: number;
  posts: BlogPost[];
  totalPages: number;
}

const { basePath, currentPage, posts, totalPages } = Astro.props;
const isFirstPage = currentPage === 1;
const title = isFirstPage ? SITE.title : `Writing — Page ${currentPage}`;
---

<BaseLayout
  title={title}
  description="Essays, experiments, histories, and notes—organized mostly by curiosity."
>
  {
    isFirstPage ? (
      <section class="blog-hero">
        <MatrixBackdrop />
        <div class="blog-hero__content section-shell">
          <h1>Writing</h1>
          <p>{SITE.tagline}</p>
        </div>
      </section>
    ) : (
      <section class="page-heading section-shell">
        <h1>Writing</h1>
        <p>Page {currentPage} of the archive.</p>
      </section>
    )
  }

  <section class="section-shell blog-listing" aria-label="Posts">
    {
      posts.length > 0 ? (
        <div class="post-list">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>The first signal is still being tuned. Check back soon.</p>
        </div>
      )
    }
    <Pagination
      basePath={basePath}
      currentPage={currentPage}
      totalPages={totalPages}
    />
  </section>
</BaseLayout>
