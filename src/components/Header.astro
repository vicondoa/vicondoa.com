---
import { SITE } from '../site.config';
import ThemeToggle from './ThemeToggle.astro';

const pathname = Astro.url.pathname;
const navigation = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/topics', label: 'Topics' },
  { href: '/about', label: 'About' },
];

const isActive = (href: string) =>
  href === '/'
    ? pathname === href
    : pathname === href || pathname.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="wordmark" href="/" aria-label={`${SITE.title}, home`}>
      <span class="wordmark__signal" aria-hidden="true"></span>
      <span>{SITE.title}</span>
    </a>

    <nav class="site-nav" aria-label="Primary navigation">
      {
        navigation.map(({ href, label }) => (
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
            {label}
          </a>
        ))
      }
    </nav>

    <div class="site-header__actions">
      <a
        class="icon-link"
        href={SITE.githubUrl}
        target="_blank"
        rel="me noopener noreferrer"
        aria-label="John Vicondoa on GitHub (opens in a new tab)"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.24c-3.21.7-3.89-1.36-3.89-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.71.08-.71 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.26-1.28-5.26-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.16 1.18A10.9 10.9 0 0 1 12 6.08c.98 0 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.23 2.77.11 3.06.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.42.36.78 1.06.78 2.14v3.28c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"
          ></path>
        </svg>
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>
