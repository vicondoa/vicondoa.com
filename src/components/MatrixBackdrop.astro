---
const hexCharacters = '0123456789ABCDEF';
const columns = Array.from({ length: 38 }, (_, columnIndex) => {
  const characters = Array.from({ length: 36 }, (_, rowIndex) => {
    const characterIndex =
      columnIndex * 11 + rowIndex * 7 + ((columnIndex + rowIndex) % 5) * 3;

    return hexCharacters[characterIndex % hexCharacters.length];
  });

  return {
    accent: columnIndex % 7 === 2 || columnIndex % 11 === 6,
    characters,
    x: 18 + columnIndex * 39,
    y: -((columnIndex * 47) % 240),
  };
});
---

<div class="matrix-backdrop" aria-hidden="true">
  <svg viewBox="0 0 1440 560" preserveAspectRatio="xMidYMid slice">
    <defs>
      <linearGradient id="matrix-vertical-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="white" stop-opacity="0.08"></stop>
        <stop offset="0.16" stop-color="white" stop-opacity="0.82"></stop>
        <stop offset="0.72" stop-color="white"></stop>
        <stop offset="1" stop-color="white" stop-opacity="0.12"></stop>
      </linearGradient>
      <mask id="matrix-mask">
        <rect width="1440" height="560" fill="url(#matrix-vertical-fade)"
        ></rect>
      </mask>
    </defs>

    <g class="matrix-backdrop__grid">
      <path
        d="M0 70H1440M0 140H1440M0 210H1440M0 280H1440M0 350H1440M0 420H1440M0 490H1440"
      ></path>
      <path
        d="M90 0V560M180 0V560M270 0V560M360 0V560M450 0V560M540 0V560M630 0V560M720 0V560M810 0V560M900 0V560M990 0V560M1080 0V560M1170 0V560M1260 0V560M1350 0V560"
      ></path>
    </g>

    <g mask="url(#matrix-mask)">
      {
        columns.map(({ accent, characters, x, y }) => (
          <text
            class:list={[
              'matrix-backdrop__column',
              { 'matrix-backdrop__column--accent': accent },
            ]}
            x={x}
            y={y}
          >
            {characters.map((character, rowIndex) => (
              <tspan x={x} dy={rowIndex === 0 ? 0 : 19}>
                {character}
              </tspan>
            ))}
          </text>
        ))
      }
    </g>
  </svg>
</div>
