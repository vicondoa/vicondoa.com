---
const hexCharacters = '0123456789ABCDEF';
const pairs = Array.from({ length: 70 * 13 }, (_, cellIndex) => {
  const columnIndex = cellIndex % 70;
  const rowIndex = Math.floor(cellIndex / 70);
  const hash =
    columnIndex * 37 +
    rowIndex * 61 +
    columnIndex * rowIndex * 7 +
    (columnIndex % 9) * 13;
  const firstCharacter = hexCharacters[hash % hexCharacters.length];
  const secondCharacter =
    hexCharacters[
      (hash * 5 + columnIndex + rowIndex * 3) % hexCharacters.length
    ];

  return {
    accent: hash % 17 === 3,
    dim: hash % 7 === 0,
    value: `${firstCharacter}${secondCharacter}`,
    x: 5 + columnIndex * 20.55,
    y: 11 + rowIndex * 15,
  };
});
---

<div class="matrix-backdrop" aria-hidden="true">
  <svg viewBox="0 0 1440 190" preserveAspectRatio="xMidYMid slice">
    <defs>
      <filter
        id="matrix-distortion"
        x="-8%"
        y="-20%"
        width="116%"
        height="140%"
      >
        <feTurbulence
          type="fractalNoise"
          baseFrequency="0.012 0.045"
          numOctaves="2"
          seed="19"
          result="noise"></feTurbulence>
        <feDisplacementMap
          in="SourceGraphic"
          in2="noise"
          scale="15"
          xChannelSelector="R"
          yChannelSelector="B"
          result="distorted"></feDisplacementMap>
        <feGaussianBlur in="distorted" stdDeviation="1.4"></feGaussianBlur>
      </filter>
      <linearGradient id="matrix-edge-fade" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="white" stop-opacity="0.35"></stop>
        <stop offset="0.24" stop-color="white"></stop>
        <stop offset="0.76" stop-color="white"></stop>
        <stop offset="1" stop-color="white" stop-opacity="0.28"></stop>
      </linearGradient>
      <mask id="matrix-mask">
        <rect width="1440" height="190" fill="url(#matrix-edge-fade)"></rect>
      </mask>
    </defs>

    <g filter="url(#matrix-distortion)" mask="url(#matrix-mask)">
      {
        pairs.map(({ accent, dim, value, x, y }) => (
          <text
            class:list={[
              'matrix-backdrop__pair',
              {
                'matrix-backdrop__pair--accent': accent,
                'matrix-backdrop__pair--dim': dim,
              },
            ]}
            x={x}
            y={y}
          >
            {value}
          </text>
        ))
      }
    </g>
  </svg>
</div>
