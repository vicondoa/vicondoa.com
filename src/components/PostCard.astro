---
import type { BlogPost } from '../lib/blog';
import { getPostUrl, getReadingTime, slugifyTopic } from '../lib/blog';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<article class="post-card">
  <div class="post-card__meta">
    <FormattedDate date={post.data.publishedAt} />
    <span aria-hidden="true">/</span>
    <span>{getReadingTime(post)} min read</span>
  </div>
  <h2 class="post-card__title">
    <a href={getPostUrl(post)}>{post.data.title}</a>
  </h2>
  <p class="post-card__description">{post.data.description}</p>
  <ul class="topic-list" aria-label="Topics">
    {
      post.data.topics.map((topic) => (
        <li>
          <a class="topic-pill" href={`/topics/${slugifyTopic(topic)}`}>
            {topic}
          </a>
        </li>
      ))
    }
  </ul>
</article>
